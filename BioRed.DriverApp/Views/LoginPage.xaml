<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BioRed.DriverApp.ViewModels"
             x:Class="BioRed.DriverApp.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1A252C">

    <Grid VerticalOptions="Center" Padding="30">
        <VerticalStackLayout Spacing="20">

            <!-- Encabezado / Logo -->
            <Label Text="BioRed Driver 🚴‍♂️" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   TextColor="#00D1B2" 
                   HorizontalOptions="Center" />

            <Label Text="Portal de Repartidores" 
                   FontSize="14" 
                   TextColor="White" 
                   HorizontalOptions="Center" />

            <!-- Formulario -->
            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#2C3E50" Padding="15">
                <VerticalStackLayout Spacing="15">

                    <Entry Placeholder="Correo de Repartidor" 
                           PlaceholderColor="Gray"
                           TextColor="White"
                           Text="{Binding Email}" 
                           Keyboard="Email" />

                    <BoxView HeightRequest="1" Color="#4A6572" />

                    <Entry Placeholder="Contraseña" 
                           PlaceholderColor="Gray"
                           TextColor="White"
                           Text="{Binding Password}" 
                           IsPassword="True" />
                </VerticalStackLayout>
            </Border>

            <!-- Botón de Login -->
            <Button Text="Iniciar Turno" 
                    Command="{Binding LoginCommand}" 
                    BackgroundColor="#00D1B2" 
                    TextColor="Black" 
                    CornerRadius="10" 
                    HeightRequest="50" 
                    FontAttributes="Bold"/>

            <!-- Indicador de carga -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}" 
                               Color="#00D1B2" 
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>