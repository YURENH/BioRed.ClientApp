<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BioRed.ClientApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BioRed.ClientApp.Views"
    Title="BioRed">

    <!-- 🟢 La página de Inicio predeterminada al cargar la aplicación -->
    <ShellContent
        Title="Inicio"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePage" />
    <ShellContent Title="Mis Pedidos" 
                  Icon="orders_icon.png" 
                  ContentTemplate="{DataTemplate views:MisPedidosPage}" />

</Shell>