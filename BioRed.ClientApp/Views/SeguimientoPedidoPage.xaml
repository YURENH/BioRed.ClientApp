<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BioRed.ClientApp.ViewModels"
             x:Class="BioRed.ClientApp.Views.SeguimientoPedidoPage"
             x:DataType="vm:SeguimientoPedidoViewModel"
             Title="Estado del Pedido"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">

            <Image Source="icono_caja.png" 
                   HeightRequest="100" 
                   HorizontalOptions="Center" 
                   Margin="0,20,0,10" />
            <!-- Puedes poner un ícono representativo aquí -->

            <Label Text="Detalles de tu entrega" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="#333" />

            <!-- Tarjeta Informativa -->
            <Border Padding="20" 
                    BackgroundColor="White" 
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Shadow="{Shadow Brush=Gray, Offset='0,5', Opacity=0.2, Radius=10}">
                <VerticalStackLayout Spacing="15">

                    <Label Text="{Binding MensajeEstado}" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="{Binding ColorEstado}" 
                           HorizontalOptions="Center" 
                           HorizontalTextAlignment="Center" />

                    <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Label Text="Repartidor asignado:" TextColor="Gray" FontSize="16" />
                        <Label Text="{Binding NombreRepartidor}" FontAttributes="Bold" FontSize="16" TextColor="#333" />
                    </HorizontalStackLayout>

                    <Button Text="Llamar al Repartidor"
                            Command="{Binding LlamarRepartidorCommand}"
                            BackgroundColor="#007A33"
                            TextColor="White"
                            CornerRadius="8"
                            Margin="0,15,0,0"
                            FontAttributes="Bold" />

                    <Button Text="Cancelar Pedido"
                            Command="{Binding CancelarPedidoCommand}"
                            IsVisible="{Binding PuedeCancelar}"
                            BackgroundColor="#E74C3C"
                            TextColor="White"
                            CornerRadius="8"
                            Margin="0,5,0,0"
                            FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>