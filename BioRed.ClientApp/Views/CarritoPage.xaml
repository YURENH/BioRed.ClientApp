<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:BioRed.Core.DTOs;assembly=BioRed.Core"
             x:Class="BioRed.ClientApp.Views.CarritoPage"
             Title="Mi Carrito"
             BackgroundColor="#F4F6F9">

    <Grid RowDefinitions="*, Auto">
        <!-- Lista de Productos en Carrito -->
        <CollectionView Grid.Row="0" ItemsSource="{Binding Items}" Margin="15">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,100,0,0">
                    <Label Text="🛒" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Tu carrito está vacío" FontSize="16" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CartItemDto">
                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="White" Padding="15" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                            <Label Text="{Binding Producto.ProductName}" FontSize="16" FontAttributes="Bold" TextColor="#333" Grid.Row="0" Grid.Column="0" />
                            <Button Text="❌" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EliminarItemCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="Red" FontSize="14" Grid.Row="0" Grid.Column="1" HeightRequest="35" WidthRequest="35" Padding="0" />

                            <Label Text="{Binding Producto.SalePrice, StringFormat='Precio: Q {0:F2}'}" FontSize="12" TextColor="Gray" Grid.Row="1" Grid.Column="0" />
                            <Label Text="{Binding Quantity, StringFormat='Cant: {0}'}" FontSize="12" FontAttributes="Bold" TextColor="#0066CC" Grid.Row="1" Grid.Column="1" HorizontalOptions="End" />

                            <Label Text="{Binding Subtotal, StringFormat='Subtotal: Q {0:F2}'}" FontSize="14" FontAttributes="Bold" TextColor="#27AE60" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Panel Inferior de Total y Checkout -->
        <Border Grid.Row="1" BackgroundColor="White" Padding="20" StrokeShape="RoundRectangle 16,16,0,0" StrokeThickness="0">
            <VerticalStackLayout Spacing="15">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Total a pagar:" FontSize="18" FontAttributes="Bold" TextColor="#333" VerticalOptions="Center" />
                    <Label Text="{Binding Total, StringFormat='Q {0:F2}'}" Grid.Column="1" FontSize="24" FontAttributes="Bold" TextColor="#27AE60" />
                </Grid>
                <VerticalStackLayout Padding="15" Spacing="10">
                    <Label Text="Dirección de Entrega:" 
           FontAttributes="Bold" 
           FontSize="16" />

                    <Picker Title="-- Selecciona tu dirección --"
            ItemsSource="{Binding Direcciones}"
            SelectedItem="{Binding DireccionSeleccionada}"
            ItemDisplayBinding="{Binding DisplayText}"
            FontSize="14" />

                    <!-- Selección de Método de Pago -->
                    <Label Text="Método de Pago:" 
       FontAttributes="Bold" 
       FontSize="15" 
       Margin="0,10,0,0" />

                    <Picker Title="-- Selecciona método de pago --"
        ItemsSource="{Binding MetodosPago}"
        SelectedItem="{Binding MetodoPagoSeleccionado}"
        ItemDisplayBinding="{Binding DisplayName}"
        Margin="0,0,0,15" />
                </VerticalStackLayout>
                <Button Text="Confirmar Pedido" Command="{Binding ProcesarPedidoCommand}" BackgroundColor="#27AE60" TextColor="White" FontAttributes="Bold" FontSize="18" HeightRequest="50" CornerRadius="12" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>